// clusterkmeans.nv — k-means, and the random draws that arrive from
// outside.
//
// WHAT K-MEANS IS.  Choose `k` starting points, called CENTROIDS.
// Assign every sample to the nearest centroid.  Move each centroid to
// the mean of the samples assigned to it.  Repeat until nothing moves.
// The quantity it is minimising is the INERTIA — the sum, over every
// sample, of the squared distance from that sample to its centroid —
// and the two steps each decrease it, which is why the iteration
// converges.
//
// THE RANDOMNESS ARRIVES AS AN ARGUMENT.  This is the decision the
// rest of the module follows from.  k-means has to start somewhere,
// and the standard start — k-means++ — draws its centroids at random,
// each one with a probability proportional to its squared distance
// from the nearest centroid already chosen.  A `core` package may not
// draw a random number: `[rand]` is a host effect.
//
// So the draws are an argument.  `seed_plus_plus` takes a list of
// uniform numbers in `[0, 1)`, one per centroid it has to choose, and
// `uniforms_needed` says how many that is.  The caller draws them from
// whatever generator it already has and hands them over.
//
// That is not a workaround, and it buys three things the usual design
// cannot.  A run is REPRODUCIBLE: the same data and the same draws
// give the same clustering, every time, on every machine, with no
// seed-setting ritual and no global state.  A TEST needs no fake
// generator and no mocking: it writes the draws it wants and asserts
// the exact clustering they produce, which is what the suite here
// does.  And the caller CHOOSES ITS GENERATOR — a cryptographic one, a
// counter-based one it can replay, a low-discrepancy sequence — rather
// than inheriting whatever the library linked.
//
// A caller that has its own idea of where to start skips the seeding
// entirely and hands `fit` the centroids it wants.
//
// K-MEANS IS DEFINED FOR ONE METRIC.  The update step is the MEAN, and
// the mean of a set of points is the point that minimises the sum of
// squared Euclidean distances to them — and nothing else.  Under the
// Manhattan distance the minimiser is the median and the algorithm is
// a different one, k-medians.  So no function here takes a
// `ClusterMetric`: saying so is more useful than accepting a metric
// and quietly ignoring it, which is what a library that takes one and
// then computes means is doing.

use clusterfault
use clusterlabels
use ndfloat

// A fitted k-means model: the labels, where the centroids ended, what
// the inertia is, and how the iteration ended.
//
// ```novo
// use clusterkmeans
// use clusterlabels
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([0.0, 0.0, 10.0, 10.0], [2, 1])
//         Err(e) => println(e.message())
//         Ok(data) =>
//             match clusterkmeans.fit_seeded(data, 2, [0.0, 0.5], 100, 0.000001)
//                 Ok(m)  => println("${clusterlabels.cluster_count(m.labels)}")   // 2
//                 Err(e) => println(e.message())
// ```
pub struct ClusterKmeansModel
    // Which cluster each sample ended in.  `noise_count` is always 0:
    // k-means assigns every sample.
    labels: ClusterLabels
    // Where the centroids ended, as a `[k, n_features]` array.  Row
    // `c` is the centroid of cluster `c`.
    centroids: NdFloat
    // The sum over every sample of the squared distance to its own
    // centroid.  The quantity the iteration minimises, and the number
    // to compare two fits of the same data by — a fit with a lower
    // inertia is a better one, and a fit with a LOT lower is usually a
    // luckier seeding rather than a better `k`.
    inertia: Float
    // Whether the iteration reached a fixed point, used up its budget,
    // or degenerated.
    status: ClusterStatus
    // How many assign-and-move passes ran.
    iterations: Int

// How many uniform draws `seed_plus_plus` needs to choose `k`
// centroids.
//
// One for the first centroid, which is drawn uniformly from the
// samples, and one for each of the `k - 1` that follow, which are
// drawn with a probability proportional to the squared distance from
// the nearest centroid already chosen.  So it is `k`, and the function
// exists so that a caller never has to know that, and so that a change
// of seeding strategy does not silently read past the end of somebody's
// list.
//
// ```novo
// use clusterkmeans
//
// fn main() [io]
//     println("${clusterkmeans.uniforms_needed(3)}")   // 3
// ```
pub fn uniforms_needed(k: Int) -> Int
    k

// The `[rows, width]` extents of a rank-2 data matrix, or the fault
// that says why the array is not one.
//
// A rank-1 array of measurements has to be reshaped by the caller,
// because only the caller knows whether it is one feature of many
// samples or many features of one.
fn matrix_extents(data: NdFloat) -> Result<[Int], ClusterFault>
    let dims = ndfloat.shape(data).dims[:]
    if list.len(dims) != 2
        return Err(ClusterNotMatrix(list.len(dims)))
    if dims[0] == 0
        return Err(ClusterEmptyData)
    Ok(dims)

// The squared distance from sample `row` to centroid `c`, both read out
// of row-major buffers `width` features wide.
//
// Squared, and never square-rooted, because every question this module
// asks is a nearest-point question and the two orders agree.
fn sq_to_centroid(flat: [Float], row: Int, cents: [Float], c: Int, width: Int) -> Float
    var total = 0.0
    for f in 0..width
        let d = flat[row * width + f] - cents[c * width + f]
        total = total + d * d
    total

// The index of the centroid nearest sample `row`.
//
// A sample exactly between two centroids goes to the lower-numbered
// one, which is what makes a fit reproducible when the data is
// symmetric.
fn nearest_one(flat: [Float], row: Int, cents: [Float], k: Int, width: Int) -> Int
    var best = 0
    var best_d = sq_to_centroid(flat, row, cents, 0, width)
    for c in 1..k
        let d = sq_to_centroid(flat, row, cents, c, width)
        if d < best_d
            best = c
            best_d = d
    best

// Which cluster every sample is nearest to, in row order.
fn nearest_all(flat: [Float], rows: Int, width: Int, cents: [Float], k: Int) -> [Int]
    var out: [Int] = []
    for row in 0..rows
        list.push(out, nearest_one(flat, row, cents, k, width))
    out

// Every sample's squared distance to the nearest of `k` centroids.
//
// This is k-means++'s sampling weight: the next centroid is drawn with
// a probability proportional to it.
fn nearest_sq(flat: [Float], rows: Int, width: Int, cents: [Float], k: Int) -> [Float]
    var out: [Float] = []
    for row in 0..rows
        let at = nearest_one(flat, row, cents, k, width)
        list.push(out, sq_to_centroid(flat, row, cents, at, width))
    out

// The sample a uniform draw picks from `rows` samples, uniformly.
//
// A draw just below 1.0 can still reach `rows` once the multiplication
// rounds, and the last sample is where it belongs.
fn picked_row(u: Float, rows: Int) -> Int
    let at = float.to_int(u * int.to_float(rows))
    if at >= rows
        // cov: skip — unreachable: a draw below 1.0 never rounds up to rows
        rows - 1
    else
        at

// Copy sample `row`'s features onto the end of `out`.
fn append_row(var out: [Float], flat: [Float], row: Int, width: Int)
    for f in 0..width
        list.push(out, flat[row * width + f])

// The mean of each cluster's rows, in cluster order and row-major.
//
// A cluster with no members has no mean of its own, so its row is
// copied from `fallback` instead.  The row of zeros it would otherwise
// get is a point that attracts the next assignment.
//
// A sample carrying the noise label belongs to no cluster and
// contributes to none.
fn cluster_means(flat: [Float], rows: Int, width: Int, assignment: [Int], clusters: Int,
                 fallback: [Float]) -> [Float]
    var out: [Float] = list.map(0..clusters * width, i => 0.0)
    var counts: [Int] = list.zeros(clusters)
    for row in 0..rows
        let c = assignment[row]
        if c >= 0 and c < clusters
            counts[c] = counts[c] + 1
            for f in 0..width
                out[c * width + f] = out[c * width + f] + flat[row * width + f]
    for c in 0..clusters
        if counts[c] == 0
            for f in 0..width
                out[c * width + f] = fallback[c * width + f]
        else
            for f in 0..width
                out[c * width + f] = out[c * width + f] / int.to_float(counts[c])
    out

// The furthest any centroid moved between two passes.
//
// The comparison is against the Euclidean distance, because a
// tolerance is a distance a caller can picture, and a squared one
// would be the square of it.
fn worst_move(before: [Float], after: [Float], clusters: Int, width: Int) -> Float
    var worst = 0.0
    for c in 0..clusters
        var total = 0.0
        for f in 0..width
            let d = after[c * width + f] - before[c * width + f]
            total = total + d * d
        let moved = math.sqrt(total)
        if moved > worst
            worst = moved
    worst

// The squared distance from one plain point to centroid `c`.
//
// `predict` is the caller: a point that arrived on its own is a list,
// not a row of a matrix, and never becomes one.
fn squared_to_point(cents: [Float], c: Int, width: Int, point: [Float]) -> Float
    var total = 0.0
    for f in 0..width
        let d = cents[c * width + f] - point[f]
        total = total + d * d
    total

// `k` starting centroids chosen from the data by k-means++, using the
// uniform draws the caller supplies.
//
// `uniforms` must hold exactly `uniforms_needed(k)` numbers, each in
// `[0, 1)` — `ClusterUniformCountWrong` and `ClusterUniformOutOfRange`
// say which rule was broken, and the second carries the index and the
// value, because the usual cause is a generator returning a closed
// interval or a raw integer.
//
// The result is a `[k, n_features]` array ready to hand to `fit`.
// Two runs with the same data and the same draws give the same
// centroids: nothing here consults anything the caller cannot see.
//
// ```novo
// use clusterkmeans
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([0.0, 1.0, 10.0, 11.0], [4, 1])
//         Err(e) => println(e.message())
//         Ok(data) =>
//             match clusterkmeans.seed_plus_plus(data, 2, [0.0, 0.9])
//                 Ok(c)  => println("${ndfloat.shape(c).dims}")   // [2, 1]
//                 Err(e) => println(e.message())
// ```
pub fn seed_plus_plus(data: NdFloat, k: Int, uniforms: [Float]) -> Result<NdFloat, ClusterFault>
    let dims = matrix_extents(data)!
    let rows = dims[0]
    let width = dims[1]
    if k < 1 or k > rows
        return Err(ClusterBadK(k, rows))
    let needed = uniforms_needed(k)
    if list.len(uniforms) != needed
        return Err(ClusterUniformCountWrong(list.len(uniforms), needed))
    for i in 0..list.len(uniforms)
        let u = uniforms[i]
        if u < 0.0 or u >= 1.0
            return Err(ClusterUniformOutOfRange(i, u))
    let flat = ndfloat.to_list(data)
    var chosen: [Float] = []
    append_row(var chosen, flat, picked_row(uniforms[0], rows), width)
    var count = 1
    while count < k
        let weights = nearest_sq(flat, rows, width, chosen, count)
        let total = list.sum_float(weights)
        let target = uniforms[count] * total
        var pick = rows - 1
        if total > 0.0
            var running = 0.0
            for j in 0..rows
                running = running + weights[j]
                if running >= target
                    pick = j
                    break
        append_row(var chosen, flat, pick, width)
        count = count + 1
    match ndfloat.of_list(chosen, [k, width])
        // cov: skip — unreachable: chosen holds exactly k rows of width
        Err(e) => Err(ClusterArrayFault(e))
        Ok(c)  => Ok(c)

// Fit k-means to `data` from these starting centroids.
//
// `data` is `[n_samples, n_features]` and `centroids` is
// `[k, n_features]`; `ClusterCentroidShapeWrong` carries both shapes
// when they do not agree.  The iteration stops when no centroid moves
// further than `tolerance`, or when `max_iterations` passes have run —
// and the model's `status` says which, so a caller can tell a fixed
// point from a budget that ran out.
//
// This is the entry point for a caller that already knows where to
// start: a previous fit's centroids, a domain-specific guess, or a
// grid.  Nothing random happens in it at all.
//
// ```novo
// use clusterkmeans
// use clusterlabels
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([0.0, 1.0, 10.0, 11.0], [4, 1])
//         Err(e) => println(e.message())
//         Ok(data) =>
//             match ndfloat.of_list([0.0, 10.0], [2, 1])
//                 Err(e) => println(e.message())
//                 Ok(start) =>
//                     match clusterkmeans.fit(data, start, 100, 0.000001)
//                         Ok(m)  => println(clusterlabels.status_name(m.status))   // converged
//                         Err(e) => println(e.message())
// ```
pub fn fit(data: NdFloat, centroids: NdFloat, max_iterations: Int,
           tolerance: Float) -> Result<ClusterKmeansModel, ClusterFault>
    let dims = matrix_extents(data)!
    let rows = dims[0]
    let width = dims[1]
    let start = ndfloat.shape(centroids).dims[:]
    if list.len(start) != 2
        return Err(ClusterNotMatrix(list.len(start)))
    let k = start[0]
    if k < 1
        return Err(ClusterBadK(k, rows))
    if start[1] != width
        return Err(ClusterCentroidShapeWrong(k, width, k, start[1]))
    if max_iterations < 1
        return Err(ClusterBadBudget(max_iterations))
    let flat = ndfloat.to_list(data)
    var current = ndfloat.to_list(centroids)
    var assignment: [Int] = []
    var iterations = 0
    var status = ClusterBudgetExhausted
    while iterations < max_iterations
        var nearest = nearest_all(flat, rows, width, current, k)
        var moved = cluster_means(flat, rows, width, nearest, k, current)
        let step = worst_move(current, moved, k, width)
        current = moved
        assignment = nearest
        iterations = iterations + 1
        let here = ClusterLabels { assignment: nearest, cluster_count: k, noise_count: 0 }
        if list.contains(clusterlabels.sizes(here), 0)
            status = ClusterDegenerate("an empty cluster after an assignment")
            break
        if step <= tolerance
            status = ClusterConverged
            break
    let labels = ClusterLabels { assignment: assignment, cluster_count: k, noise_count: 0 }
    match ndfloat.of_list(current, [k, width])
        // cov: skip — unreachable: current holds exactly k rows of width
        Err(e)   => Err(ClusterArrayFault(e))
        Ok(cent) =>
            match inertia(data, cent, labels)
                // cov: skip — not reached: fit checked every shape first
                Err(e) => Err(e)
                Ok(v)  => Ok(ClusterKmeansModel { labels: labels, centroids: cent, inertia: v,
                                                  status: status, iterations: iterations })

// `seed_plus_plus` followed by `fit`, in one call.
//
// The ordinary entry point.  It takes the uniform draws for the same
// reason `seed_plus_plus` does, and it is a convenience rather than a
// different algorithm: the two-call form is there for a caller that
// wants to look at the seeding, or to seed once and fit several times.
//
// ```novo
// use clusterkmeans
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([0.0, 1.0, 10.0, 11.0], [4, 1])
//         Err(e) => println(e.message())
//         Ok(data) =>
//             match clusterkmeans.fit_seeded(data, 2, [0.0, 0.9], 100, 0.000001)
//                 Ok(m)  => println("${m.inertia}")   // 1
//                 Err(e) => println(e.message())
// ```
pub fn fit_seeded(data: NdFloat, k: Int, uniforms: [Float], max_iterations: Int,
                  tolerance: Float) -> Result<ClusterKmeansModel, ClusterFault>
    let centroids = seed_plus_plus(data, k, uniforms)!
    fit(data, centroids, max_iterations, tolerance)

// Assign every sample to its nearest centroid, with no iteration.
//
// One pass of the first half of the algorithm.  It is public because
// it is what a caller does with NEW data against an existing fit —
// scoring a batch against last week's centroids — and because
// reimplementing "nearest centroid" is how a caller's scoring drifts
// from the fit that produced the centroids.
//
// ```novo
// use clusterkmeans
// use clusterlabels
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([0.0, 1.0, 10.0], [3, 1])
//         Err(e) => println(e.message())
//         Ok(data) =>
//             match ndfloat.of_list([0.0, 10.0], [2, 1])
//                 Err(e) => println(e.message())
//                 Ok(c) =>
//                     match clusterkmeans.assign(data, c)
//                         Ok(l)  => println("${clusterlabels.labels_of(l)}")   // [0, 0, 1]
//                         Err(e) => println(e.message())
// ```
pub fn assign(data: NdFloat, centroids: NdFloat) -> Result<ClusterLabels, ClusterFault>
    let dims = matrix_extents(data)!
    let rows = dims[0]
    let width = dims[1]
    let cent = ndfloat.shape(centroids).dims[:]
    if list.len(cent) != 2
        return Err(ClusterNotMatrix(list.len(cent)))
    let k = cent[0]
    if k < 1
        return Err(ClusterBadK(k, rows))
    if cent[1] != width
        return Err(ClusterCentroidShapeWrong(k, width, k, cent[1]))
    let flat = ndfloat.to_list(data)
    let cents = ndfloat.to_list(centroids)
    let assignment = nearest_all(flat, rows, width, cents, k)
    Ok(ClusterLabels { assignment: assignment, cluster_count: k, noise_count: 0 })

// The inertia of an assignment: the sum over every sample of the
// squared distance to the centroid it was assigned to.
//
// The number `fit` minimises, computable on its own so that a caller
// can score a clustering it did not produce here, compare two values
// of `k`, or check what the model says.  Samples with the noise label
// contribute nothing, so an assignment from DBSCAN can be scored too.
//
// ```novo
// use clusterkmeans
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([0.0, 2.0], [2, 1])
//         Err(e) => println(e.message())
//         Ok(data) =>
//             match ndfloat.of_list([1.0], [1, 1])
//                 Err(e) => println(e.message())
//                 Ok(c) =>
//                     match clusterkmeans.assign(data, c)
//                         Err(e) => println(e.message())
//                         Ok(l)  =>
//                             match clusterkmeans.inertia(data, c, l)
//                                 Ok(v)  => println("${v}")   // 2
//                                 Err(e) => println(e.message())
// ```
pub fn inertia(data: NdFloat, centroids: NdFloat,
               labels: ClusterLabels) -> Result<Float, ClusterFault>
    let dims = matrix_extents(data)!
    let rows = dims[0]
    let width = dims[1]
    let cent = ndfloat.shape(centroids).dims[:]
    if list.len(cent) != 2
        return Err(ClusterNotMatrix(list.len(cent)))
    let k = cent[0]
    if k < 1
        return Err(ClusterBadK(k, rows))
    if cent[1] != width
        return Err(ClusterCentroidShapeWrong(k, width, k, cent[1]))
    let assignment = labels.assignment
    if list.len(assignment) != rows
        return Err(ClusterBadCut("a labelling of ${list.len(assignment)} label(s) over ${rows} sample(s)"))
    let flat = ndfloat.to_list(data)
    let cents = ndfloat.to_list(centroids)
    var total = 0.0
    for row in 0..rows
        let c = assignment[row]
        if c != clusterlabels.noise_label()
            if c < 0 or c >= k
                return Err(ClusterIndexOutOfRange(c, k))
            total = total + sq_to_centroid(flat, row, cents, c, width)
    Ok(total)

// The cluster one point belongs to, against these centroids.
//
// The single-point form of `assign`, for scoring one observation as it
// arrives rather than a batch.  `point` is a plain list of
// `n_features` numbers; `ClusterCentroidShapeWrong` carries both
// lengths when it is the wrong size.
//
// ```novo
// use clusterkmeans
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([0.0, 10.0], [2, 1])
//         Err(e) => println(e.message())
//         Ok(c) =>
//             match clusterkmeans.predict(c, [9.0])
//                 Ok(i)  => println("${i}")   // 1
//                 Err(e) => println(e.message())
// ```
pub fn predict(centroids: NdFloat, point: [Float]) -> Result<Int, ClusterFault>
    let cent = ndfloat.shape(centroids).dims[:]
    if list.len(cent) != 2
        return Err(ClusterNotMatrix(list.len(cent)))
    let k = cent[0]
    let width = cent[1]
    if k < 1
        return Err(ClusterBadK(k, list.len(point)))
    if list.len(point) != width
        return Err(ClusterCentroidShapeWrong(1, width, 1, list.len(point)))
    let cents = ndfloat.to_list(centroids)
    var best = 0
    var best_d = squared_to_point(cents, 0, width, point)
    for c in 1..k
        let d = squared_to_point(cents, c, width, point)
        if d < best_d
            best = c
            best_d = d
    Ok(best)

// The centroids of an assignment: the mean of the samples in each
// cluster.
//
// One pass of the second half of the algorithm.  It is public because
// it is how a caller turns labels it got from somewhere else —
// DBSCAN, an agglomerative cut, a hand-made grouping — into centroids
// it can score with `inertia` or `predict` against.  A cluster with no
// members has no mean, and the result is `ClusterDegenerate` rather
// than a row of zeros that would quietly attract points.
//
// ```novo
// use clusterkmeans
// use clusterlabels
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([0.0, 2.0, 10.0, 12.0], [4, 1])
//         Err(e) => println(e.message())
//         Ok(data) =>
//             let l = ClusterLabels { assignment: [0, 0, 1, 1], cluster_count: 2, noise_count: 0 }
//             match clusterkmeans.centroids_of(data, l)
//                 Ok(c)  => println("${ndfloat.to_list(c)}")   // [1, 11]
//                 Err(e) => println(e.message())
// ```
pub fn centroids_of(data: NdFloat, labels: ClusterLabels) -> Result<NdFloat, ClusterFault>
    let dims = matrix_extents(data)!
    let rows = dims[0]
    let width = dims[1]
    let assignment = labels.assignment
    let clusters = labels.cluster_count
    if list.len(assignment) != rows
        return Err(ClusterBadCut("a labelling of ${list.len(assignment)} label(s) over ${rows} sample(s)"))
    if clusters < 1
        return Err(ClusterBadK(clusters, rows))
    for row in 0..rows
        let c = assignment[row]
        if c != clusterlabels.noise_label() and (c < 0 or c >= clusters)
            return Err(ClusterIndexOutOfRange(c, clusters))
    let sizes = clusterlabels.sizes(labels)
    for c in 0..clusters
        if sizes[c] == 0
            return Err(ClusterBadCut("a labelling with an empty cluster"))
    let flat = ndfloat.to_list(data)
    // No cluster is empty, so this fallback is never read.
    let unused: [Float] = list.map(0..clusters * width, i => 0.0)
    let means = cluster_means(flat, rows, width, assignment, clusters, unused)
    match ndfloat.of_list(means, [clusters, width])
        // cov: skip — unreachable: one mean per cluster, each a row of width
        Err(e) => Err(ClusterArrayFault(e))
        Ok(m)  => Ok(m)
