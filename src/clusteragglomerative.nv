// clusteragglomerative.nv — building the tree, and cutting it
// afterwards.
//
// WHAT AGGLOMERATIVE CLUSTERING IS.  Start with every sample its own
// cluster.  Repeatedly merge the two closest clusters, recording each
// merge and the distance it happened at, until one cluster is left.
// The record of those `n - 1` merges is a DENDROGRAM — a binary tree
// whose leaves are the samples and whose internal nodes are merges,
// each at a height equal to the distance between what it joined.
//
// THE TREE IS BUILT ONCE AND CUT MANY TIMES.  That is the property
// that makes this method worth its cost, and it is why the surface
// here is two functions rather than one.  `build` does the expensive
// part and knows nothing about how many clusters anyone wants;
// `cut_at_count` and `cut_at_distance` are cheap and can be called
// again and again on the same tree.  A caller exploring how many
// clusters its data has builds once and cuts twenty times, which no
// interface that took `k` as an argument to the fit would let it do.
//
// WHAT A LINKAGE IS.  Two clusters have many pairs of points between
// them, so "the distance between two clusters" needs a definition, and
// there are three in common use.  SINGLE linkage takes the smallest
// distance between any pair, which follows filaments and chains — it
// finds long straggly shapes and it also joins two dense blobs through
// one bridge of outliers.  COMPLETE linkage takes the largest, which
// produces compact clusters of roughly equal diameter and breaks up
// elongated ones.  AVERAGE linkage takes the mean over all pairs and
// sits between the two.  The choice is not a tuning knob; it is a
// statement about what shape the caller thinks its clusters are, and
// the three give genuinely different trees on the same data.
//
// THE MERGE ORDER IS DETERMINISTIC.  Two pairs of clusters can be
// exactly the same distance apart, and the original formulations do
// not say which to merge.  This package merges the pair with the
// smallest first index, and then the smallest second — so the same
// data gives the same tree, every time.  That is the same
// reproducibility promise the other two modules make, and it costs
// nothing to keep.

use clusterfault
use clusterlabels
use ndfloat

// How the distance between two CLUSTERS is defined, given the
// distances between their points.
//
// ```novo
// use clusteragglomerative
//
// fn main() [io]
//     println(clusteragglomerative.linkage_name(ClusterAverage))   // average
// ```
pub enum ClusterLinkage
    // The smallest distance between any point of one cluster and any
    // point of the other.  Follows chains and filaments, and joins two
    // dense groups through a single bridge of outliers.
    ClusterSingle
    // The largest such distance.  Produces compact clusters of
    // similar diameter, and breaks elongated shapes into pieces.
    ClusterComplete
    // The mean over every pair of points, one from each cluster.
    // Between the other two, and the usual first choice.
    ClusterAverage

// One merge: which two clusters joined, how far apart they were, and
// how big the result is.
//
// ```novo
// use clusteragglomerative
//
// fn main() [io]
//     let m = ClusterMerge { left: 0, right: 1, distance: 0.5, size: 2 }
//     println("${m.size}")   // 2
// ```
pub struct ClusterMerge
    // The lower-numbered of the two clusters that joined.  A number
    // below the sample count is a leaf — that sample's own cluster;
    // `sample_count + i` is the cluster that merge `i` produced.
    left: Int
    // The higher-numbered of the two, read the same way.
    right: Int
    // How far apart they were, under the tree's linkage and metric.
    // The height of this node, and the number `cut_at_distance`
    // compares against.  It never decreases down the list for complete
    // and average linkage; for single linkage it never decreases
    // either, which is what makes a cut at a height well defined.
    distance: Float
    // How many samples are in the cluster this merge produced.
    size: Int

// The whole merge history of one data set.
//
// ```novo
// use clusteragglomerative
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([0.0, 1.0, 10.0], [3, 1])
//         Err(e) => println(e.message())
//         Ok(data) =>
//             match clusteragglomerative.build(data, ClusterAverage, ClusterEuclidean)
//                 Ok(d)  => println("${d.sample_count}")   // 3
//                 Err(e) => println(e.message())
// ```
pub struct ClusterDendrogram
    // The `n - 1` merges, in the order they happened, so their
    // distances are non-decreasing.
    merges: [ClusterMerge]
    // How many samples the tree was built from.  Its leaves are
    // numbered 0 to `sample_count - 1`.
    sample_count: Int

// The linkage's name, for a log line and a fault message:
// `"single"`, `"complete"`, `"average"`.
//
// ```novo
// use clusteragglomerative
//
// fn main() [io]
//     println(clusteragglomerative.linkage_name(ClusterSingle))   // single
// ```
pub fn linkage_name(linkage: ClusterLinkage) -> Str
    match linkage
        ClusterSingle   => "single"
        ClusterComplete => "complete"
        ClusterAverage  => "average"

// The `[rows, width]` extents of a rank-2 data matrix, or the fault
// that says why the array is not one.
fn matrix_extents(data: NdFloat) -> Result<[Int], ClusterFault>
    let dims = ndfloat.shape(data).dims[:]
    if list.len(dims) != 2
        return Err(ClusterNotMatrix(list.len(dims)))
    if dims[0] == 0
        return Err(ClusterEmptyData)
    Ok(dims)

// The distance between samples `left` and `right` of a row-major
// buffer, under one metric.
//
// The three sums are accumulated in the one pass over the features and
// the metric picks between them at the end, because the first thing
// `build` does is ask this of every pair.
fn gap_of(flat: [Float], left: Int, right: Int, width: Int, metric: ClusterMetric) -> Float
    var squares = 0.0
    var absolute = 0.0
    var largest = 0.0
    for f in 0..width
        let d = math.abs(flat[left * width + f] - flat[right * width + f])
        squares = squares + d * d
        absolute = absolute + d
        if d > largest
            largest = d
    match metric
        ClusterEuclidean        => math.sqrt(squares)
        ClusterSquaredEuclidean => squares
        ClusterManhattan        => absolute
        ClusterChebyshev        => largest

// The distance from a merge to some other cluster, from the two
// distances its halves had to that cluster.
//
// This is the Lance-Williams update, and it is what makes the tree
// cost one pass over the clusters per merge rather than one over every
// pair of their points.  The mean is over all of those pairs, which is
// why it weights each half by its size.
fn linked(linkage: ClusterLinkage, a_to_x: Float, b_to_x: Float, a_size: Int, b_size: Int) -> Float
    match linkage
        ClusterSingle   => if a_to_x <= b_to_x
            a_to_x
        else
            b_to_x
        ClusterComplete => if a_to_x >= b_to_x
            a_to_x
        else
            b_to_x
        ClusterAverage  => (int.to_float(a_size) * a_to_x + int.to_float(b_size) * b_to_x) / int.to_float(a_size + b_size)

// The linkage a name denotes, or `None`.
//
// For reading a linkage out of configuration.  A spelling this package
// does not use answers `None` rather than a default: the three give
// genuinely different trees, so quietly choosing one is quietly
// choosing an answer.
//
// ```novo
// use clusteragglomerative
//
// fn main() [io]
//     match clusteragglomerative.linkage_named("complete")
//         Some(l) => println(clusteragglomerative.linkage_name(l))   // complete
//         None    => println("no such linkage")
// ```
pub fn linkage_named(name: Str) -> ?ClusterLinkage
    if name == "single"
        return Some(ClusterSingle)
    if name == "complete"
        return Some(ClusterComplete)
    if name == "average"
        return Some(ClusterAverage)
    None

// Build the merge tree for `data`.
//
// `data` is `[n_samples, n_features]`.  The expensive call, and the
// one to make once: every cut below works on the tree this returns and
// costs a single pass over the merges.
//
// All four metrics are defined, unlike in k-means: this method never
// takes a mean, it only ever compares distances between points.
//
// ```novo
// use clusteragglomerative
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([0.0, 1.0, 10.0, 11.0], [4, 1])
//         Err(e) => println(e.message())
//         Ok(data) =>
//             match clusteragglomerative.build(data, ClusterComplete, ClusterEuclidean)
//                 Ok(d)  => println("${list.len(d.merges)}")   // 3
//                 Err(e) => println(e.message())
// ```
pub fn build(data: NdFloat, linkage: ClusterLinkage,
             metric: ClusterMetric) -> Result<ClusterDendrogram, ClusterFault>
    let dims = matrix_extents(data)!
    let rows = dims[0]
    let width = dims[1]
    let flat = ndfloat.to_list(data)
    // Cluster 0 to `rows - 1` is a leaf; `rows + i` is the cluster that
    // merge `i` produced, which is what a merge record names.
    let slots = 2 * rows - 1
    var dist: [Float] = list.map(0..slots * slots, i => 0.0)
    var sizes: [Int] = list.map(0..slots, i => 1)
    var alive: [Bool] = list.map(0..slots, i => false)
    for leaf in 0..rows
        alive[leaf] = true
    for a in 0..rows
        for b in 0..rows
            dist[a * slots + b] = gap_of(flat, a, b, width, metric)
    var merges: [ClusterMerge] = []
    for step in 0..rows - 1
        // The closest live pair, the lower first index first and then
        // the lower second, which is what makes the tree deterministic.
        var left = 0
        var right = 0
        var closest = 0.0
        var found = false
        for a in 0..slots
            if alive[a]
                for b in a + 1..slots
                    if alive[b]
                        let d = dist[a * slots + b]
                        if not found or d < closest
                            left = a
                            right = b
                            closest = d
                            found = true
        let fresh = rows + step
        let joined = sizes[left] + sizes[right]
        merges = list.push(merges, ClusterMerge { left: left, right: right,
                                                  distance: closest, size: joined })
        for x in 0..slots
            if alive[x] and x != left and x != right
                let d = linked(linkage, dist[left * slots + x], dist[right * slots + x],
                               sizes[left], sizes[right])
                dist[fresh * slots + x] = d
                dist[x * slots + fresh] = d
        alive[left] = false
        alive[right] = false
        alive[fresh] = true
        sizes[fresh] = joined
    Ok(ClusterDendrogram { merges: merges, sample_count: rows })

// Cut the tree so that exactly `count` clusters remain.
//
// Undoes the last `count - 1` merges.  `ClusterBadCut` when `count` is
// below 1 or above the sample count, because neither names a
// partition.  Every sample is assigned, so the labels' `noise_count`
// is 0.
//
// This is the cut to use when the number of clusters is known from
// outside the data — a fixed number of bins, a known number of
// categories.
//
// ```novo
// use clusteragglomerative
// use clusterlabels
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([0.0, 1.0, 10.0, 11.0], [4, 1])
//         Err(e) => println(e.message())
//         Ok(data) =>
//             match clusteragglomerative.build(data, ClusterAverage, ClusterEuclidean)
//                 Err(e) => println(e.message())
//                 Ok(d)  =>
//                     match clusteragglomerative.cut_at_count(d, 2)
//                         Ok(l)  => println("${clusterlabels.labels_of(l)}")   // [0, 0, 1, 1]
//                         Err(e) => println(e.message())
// ```
pub fn cut_at_count(tree: ClusterDendrogram, count: Int) -> Result<ClusterLabels, ClusterFault>
    let samples = tree.sample_count
    if count < 1 or count > samples
        return Err(ClusterBadCut("a cluster count of ${count} over ${samples} sample(s)"))
    labels_at_step(tree, samples - count)

// Cut the tree below every merge that happened at or above
// `threshold`.
//
// Keeps the merges whose distance is strictly below the threshold and
// discards the rest, so the number of clusters is whatever the data
// gives.  `ClusterBadCut` for a negative threshold.
//
// This is the cut to use when the number of clusters is NOT known and
// a meaningful distance is — "customers within five kilometres of each
// other are one territory".  It is also what makes the tree worth
// building: the same tree answers that question at every threshold.
//
// ```novo
// use clusteragglomerative
// use clusterlabels
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([0.0, 1.0, 10.0, 11.0], [4, 1])
//         Err(e) => println(e.message())
//         Ok(data) =>
//             match clusteragglomerative.build(data, ClusterAverage, ClusterEuclidean)
//                 Err(e) => println(e.message())
//                 Ok(d)  =>
//                     match clusteragglomerative.cut_at_distance(d, 5.0)
//                         Ok(l)  => println("${clusterlabels.cluster_count(l)}")   // 2
//                         Err(e) => println(e.message())
// ```
pub fn cut_at_distance(tree: ClusterDendrogram,
                       threshold: Float) -> Result<ClusterLabels, ClusterFault>
    if threshold < 0.0
        return Err(ClusterBadCut("a distance threshold of ${threshold}"))
    var step = 0
    for m in tree.merges
        if m.distance < threshold
            step = step + 1
        else
            break
    labels_at_step(tree, step)

// The heights of the merges, in the order they happened.
//
// The dendrogram's y-axis, as numbers.  A caller choosing a threshold
// looks for the largest gap between consecutive heights: merging two
// things that are far apart, after a run of merges of things that were
// close, is the tree saying where the natural division is.
//
// ```novo
// use clusteragglomerative
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([0.0, 1.0, 10.0, 11.0], [4, 1])
//         Err(e) => println(e.message())
//         Ok(data) =>
//             match clusteragglomerative.build(data, ClusterAverage, ClusterEuclidean)
//                 Err(e) => println(e.message())
//                 Ok(d)  => println("${list.len(clusteragglomerative.merge_heights(d))}")   // 3
// ```
pub fn merge_heights(tree: ClusterDendrogram) -> [Float]
    list.map(tree.merges, m => m.distance)

// The leaf a group is held under, following the parents the replay has
// set.  A group's representative is a leaf, never a merge's number, so
// it is always a usable label for the numbering pass.
fn root_of(parent: [Int], at: Int) -> Int
    var here = at
    while parent[here] != here
        here = parent[here]
    here

// The cluster each sample is in at one step of the build, numbered
// from 0.
//
// `step` is how many merges have happened: 0 is every sample its own
// cluster, `sample_count - 1` is one cluster holding everything.  It
// is what `cut_at_count` is written in terms of, and it is public
// because an animation, a diagnostic or a test of the tree wants the
// state at a named step rather than at a named cluster count.
//
// ```novo
// use clusteragglomerative
// use clusterlabels
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([0.0, 1.0, 10.0, 11.0], [4, 1])
//         Err(e) => println(e.message())
//         Ok(data) =>
//             match clusteragglomerative.build(data, ClusterAverage, ClusterEuclidean)
//                 Err(e) => println(e.message())
//                 Ok(d)  =>
//                     match clusteragglomerative.labels_at_step(d, 0)
//                         Ok(l)  => println("${clusterlabels.cluster_count(l)}")   // 4
//                         Err(e) => println(e.message())
// ```
pub fn labels_at_step(tree: ClusterDendrogram, step: Int) -> Result<ClusterLabels, ClusterFault>
    let merges = tree.merges
    let samples = tree.sample_count
    if samples < 1 or step < 0 or step > list.len(merges)
        return Err(ClusterBadCut("a step outside the merge history"))
    // A merge names two cluster numbers, and a cluster number is a
    // leaf, or the number of an earlier merge.  So the leaves are
    // gathered into groups as the merges are replayed, and each group
    // is held under the lowest leaf in it — a number that is always
    // less than the sample count, whatever the merges produced.
    var parent: [Int] = list.map(0..samples, i => i)
    var group: [Int] = list.map(0..2 * samples - 1, i => i)
    for k in 0..step
        let m = merges[k]
        let a = root_of(parent, group[m.left])
        let b = root_of(parent, group[m.right])
        if a < b
            parent[b] = a
            group[samples + k] = a
        else
            parent[a] = b
            group[samples + k] = b
    // Number the clusters from 0 by the first sample in each, so that
    // the labels do not depend on which cluster numbers the merges
    // used.
    var seen: [Bool] = list.map(0..samples, i => false)
    var number: [Int] = list.zeros(samples)
    var labels: [Int] = []
    var next = 0
    for at in 0..samples
        let own = root_of(parent, at)
        if not seen[own]
            seen[own] = true
            number[own] = next
            next = next + 1
        list.push(labels, number[own])
    Ok(ClusterLabels { assignment: labels, cluster_count: next, noise_count: 0 })
